# ==========================================================
# JARVIS AI Voice Agent - Configuration
# ==========================================================

# --- Assistant Identity ---
JARVIS_NAME=JARVIS
JARVIS_USER_TITLE=sir

# --- Ollama / LLM Settings ---
# Host url where Ollama is reachable from the host machine running the agent
OLLAMA_HOST=http://localhost:11434
# Local instruct model to use (e.g. llama3.2:3b, qwen2.5:3b, mistral, phi3:mini)
OLLAMA_MODEL=llama3.2:3b

# --- LiveKit Connection Settings ---
# LiveKit Server URL (Cloud or local dev instance e.g. ws://127.0.0.1:7880)
LIVEKIT_URL=
# LiveKit API Key
LIVEKIT_API_KEY=
# LiveKit API Secret
LIVEKIT_API_SECRET=

# --- Speech-to-Text (STT) Settings ---
# Model size for faster-whisper: tiny.en, base.en, small.en, medium.en
WHISPER_MODEL_SIZE=base.en
# Device for STT: cpu (recommended to leave GPU VRAM for Ollama)
WHISPER_DEVICE=cpu
# Compute type: int8, float32
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# --- Text-to-Speech (TTS) Settings ---
# Piper voice name or local onnx model path
# e.g., en_US-lessac-medium, en_GB-alan-medium
PIPER_VOICE=en_US-lessac-medium

# --- Wake Word (Local Detection) ---
# Keyword to activate JARVIS (must run locally with openWakeWord/ONNX)
WAKE_WORD=jarvis
# Optional custom ONNX model path (defaults to auto-discovering in agent/wakeword/models/)
WAKE_WORD_MODEL_PATH=
# Detection confidence threshold (0.0 to 1.0)
WAKE_WORD_THRESHOLD=0.5
# Cooldown period in seconds between wake-word triggers
WAKE_WORD_COOLDOWN=1.0
# Spoken or sound response upon wake-word activation
WAKE_WORD_ACTIVATION_RESPONSE="Yes, sir?"

# --- Memory & Storage ---
SQLITE_DB_PATH=data/jarvis_memory.db
